# Sao chép thành .env.local (web) hoặc apps/mobile/.env (mobile). Không commit file .env thật.
# Để trống 2 biến Supabase → app chạy chế độ DEMO với dữ liệu mẫu trong packages/core/src/seed.

# --- Web (Next.js, apps/web/.env.local) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng ở server (server action quản trị). KHÔNG đưa cho agent khi làm với dữ liệu thật.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Mobile (Expo, apps/mobile/.env) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
