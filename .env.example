# Sao chép thành .env.local (web) hoặc apps/mobile/.env (mobile). Không commit file .env thật.
# Để trống 2 biến Supabase → app chạy chế độ DEMO với dữ liệu mẫu trong packages/core/src/seed.

# --- Web (Next.js, apps/web/.env.local) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng ở server (server action quản trị). KHÔNG đưa cho agent khi làm với dữ liệu thật.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Gmail · tự lấy giá từ biên nhận email (apps/web/src/app/api/gmail). Thiếu một biến → app hiện "Sắp có".
# Google Cloud Console → OAuth client loại "Web application", redirect URI: <NEXT_PUBLIC_SITE_URL>/api/gmail/callback.
# Scope gmail.readonly là scope "restricted": trước khi mở cho mọi người phải qua Google OAuth verification + đánh giá
# bảo mật CASA; trước đó chỉ tài khoản trong danh sách "Test users" của màn đồng ý đăng nhập được (refresh token hết hạn sau 7 ngày).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Khóa mã hóa refresh token Gmail (AES-256-GCM), 32 byte base64: `openssl rand -base64 32`. Đổi khóa = mọi người phải liên kết lại.
GMAIL_TOKEN_KEY=
# Origin bản web của app được gọi /api/gmail và được quay về sau khi đăng nhập Google (cách nhau dấu phẩy).
# Bản cài (frego://) và Expo Go (exp://) luôn được phép.
GMAIL_APP_ORIGINS=http://localhost:8081
# PayOS · doanh nghiệp nạp ví bằng VietQR, webhook tự khớp tiền (apps/web/src/lib/server/payos.ts, /api/payos/webhook).
# Lấy ở my.payos.vn → Kênh thanh toán. Thiếu một biến → cổng doanh nghiệp dùng chuyển khoản tay + Frego khớp ở Quản trị.
# Chỉ dùng ở máy chủ, KHÔNG đặt tiền tố NEXT_PUBLIC_. Địa chỉ webhook khai trên PayOS: <NEXT_PUBLIC_SITE_URL>/api/payos/webhook.
# Webhook cộng tiền qua RPC payos_credit_topup bằng SUPABASE_SERVICE_ROLE_KEY ở trên (chế độ Supabase).
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# --- Mobile (Expo, apps/mobile/.env) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Địa chỉ web Frego (máy chủ /api/gmail) để app liên kết Gmail. Trống → Gmail hiện "Sắp có" (DEMO: liên kết giả lập).
EXPO_PUBLIC_WEB_URL=
# Google Maps cho Android (bản build cài máy thật; Expo Go và iOS không cần). Để trống khi chỉ thử trên web/iOS.
GOOGLE_MAPS_ANDROID_KEY=
# Máy chủ tìm đường Valhalla (vẽ đường đi thật, km/phút/giá theo đường thật). Trống = FOSSGIS công cộng (chỉ để thử,
# tối đa 1 lượt/giây). Ra mắt: địa chỉ máy chủ Valhalla tự chạy. "off" = tắt (ước tính đường chim bay).
EXPO_PUBLIC_ROUTING_URL=
# Tìm địa chỉ khi gõ + chọn trên bản đồ (chốt: Goong). Có key Goong → dùng Goong; trống → tạm Photon công cộng.
# Key nằm trong app, ai cũng đọc được: giới hạn key/hạn mức trong trang quản lý Goong. Không commit key thật.
EXPO_PUBLIC_GOONG_API_KEY=
# Máy chủ Photon khi chưa có key Goong (trống = photon.komoot.io, chỉ để thử). "off" = chỉ tìm địa điểm có sẵn.
EXPO_PUBLIC_GEOCODING_URL=
